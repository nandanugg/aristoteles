exports[`restoreConfig the stored text and a file with other settings 1`] = `
"people:
  - name: Nanda
  - name: Dewi
roles:
  writer:
    description: writes
    intro: you write
    responsibilities:
      - one
    acts:
      - do: write
    timeout: 60
    icon: feather
  checker:
    description: checks
    intro: you check
    responsibilities:
      - one
    output: a note
    acts:
      - review:
          - writer
      - approve:
          - writer
      - assign:
          - writer
    icon: eye
  boss:
    description: leads
    intro: you lead
    responsibilities:
      - one
    acts:
      - approve:
          - writer
      - change:
          - tsd
      - assign:
          - checker
          - writer
      - split
      - direct
      - fit
    icon: crown
  linter:
    kind: program
    run: ./lint
    "on": report
    acts:
      - review:
          - writer
    checks:
      - r1
    icon: terminal
decide:
  - resultsOf: writer
    by:
      or:
        - checker
        - boss
sound: false
theme: light
"
`;

