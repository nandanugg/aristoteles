// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`readConfig a good file 1`] = `"ok"`;

exports[`readConfig a good file with no settings 1`] = `"ok"`;

exports[`readConfig an empty file 1`] = `
{
  "refused": "aristoteles.yaml: people must list at least one { name: ... }",
}
`;

exports[`readConfig a file of one scalar 1`] = `
{
  "refused": "aristoteles.yaml: "0" is not a key of aristoteles.yaml (people, limits, roles, decide, tiers, retryMinutes, hostWaitMinutes, outsideSourceHours, sound, theme)",
}
`;

exports[`readConfig no file 1`] = `
{
  "refused": "no aristoteles.yaml in <dir>; write one (see DESIGN.md section 3)",
}
`;

exports[`readConfig a file that does not parse 1`] = `
{
  "refused": "YAML Parse error: Unexpected token",
}
`;

exports[`readConfig the project key 1`] = `
{
  "refused": "aristoteles.yaml: the name of a dir is the name of its folder; remove the project key",
}
`;

exports[`readConfig the directions key 1`] = `
{
  "refused": "aristoteles.yaml: directions are not files: each one lives in aristoteles. A model drafts it (work direction new --file=<direction.yaml>), and its owner accepts it; remove the directions key",
}
`;

exports[`readConfig an unknown key 1`] = `
{
  "refused": "aristoteles.yaml: "colour" is not a key of aristoteles.yaml (people, limits, roles, decide, tiers, retryMinutes, hostWaitMinutes, outsideSourceHours, sound, theme)",
}
`;

exports[`readConfig tiers: luna 1`] = `
{
  "refused": "aristoteles.yaml: tiers.luna: only sol and terra run in terminals (a luna is a subagent)",
}
`;

exports[`readConfig tiers: a key that is not a setting 1`] = `
{
  "refused": "aristoteles.yaml: tiers.sol.bogus is not a setting of a tier (launch, resume, start, skills, errors, prompts, silentMinutes, retryInput)",
}
`;

