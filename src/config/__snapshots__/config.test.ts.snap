exports[`restoreConfig the stored text and a file with other settings 1`] = `
"people: 
  - name: Nanda
  - name: Dewi
limits: 
  low: 
    Assignment: 
      attempts: 3
  high: 
    Review: 
      rules: 4
roles: 
  writer: 
    tier: low
    description: writes
    intro: you write
    responsibilities: 
      - one
    acts: 
      - do: write
    timeout: 60
  checker: 
    tier: medium
    description: checks
    intro: you check
    responsibilities: 
      - one
    output: a note
    acts: 
      - review: 
          - writer
      - approve: 
          - writer
  boss: 
    tier: high
    description: leads
    intro: you lead
    responsibilities: 
      - one
    acts: 
      - approve: 
          - writer
      - change: 
          - tsd
  linter: 
    kind: program
    run: ./lint
    "on": report
    acts: 
      - review: 
          - writer
    checks: 
      - r1
decide: 
  - resultsOf: writer
    by: 
      or: 
        - checker
        - boss
sound: false
theme: light
"
`;

