exports[`restoreConfig the stored text and a file with other settings 1`] = `
"people:
  - name: Nanda
  - name: Dewi
models:
  opus:
    launch: "claude --session {session}"
    start: "go {agent}"
    silentMinutes: 5
    limits:
      Review:
        rules: 4
  sonnet: {}
  haiku:
    limits:
      Assignment:
        attempts: 3
roles:
  writer:
    model: haiku
    description: writes
    intro: you write
    responsibilities:
      - one
    acts:
      - do: write
    timeout: 60
    persistence:
      persistent: false
      why: it does one piece of work once
    icon: feather
  checker:
    model: sonnet
    description: checks
    intro: you check
    responsibilities:
      - one
    output: a note
    acts:
      - review:
          - writer
      - approve:
          - writer
      - assign:
          - writer
    persistence:
      &persistence
      persistent: true
      why: it leads the project
    icon: eye
  boss:
    model: opus
    description: leads
    intro: you lead
    responsibilities:
      - one
    acts:
      - approve:
          - writer
      - change:
          - tsd
      - assign:
          - checker
          - writer
      - split
      - direct
      - fit
    persistence:
      *persistence
    icon: crown
  linter:
    kind: program
    run: ./lint
    "on": report
    acts:
      - review:
          - writer
    checks:
      - r1
    icon: terminal
decide:
  - resultsOf: writer
    by:
      or:
        - checker
        - boss
sound: false
theme: light
"
`;

