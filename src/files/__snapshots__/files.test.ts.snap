// Bun Snapshot v1, https://bun.sh/docs/test/snapshots
// Bun 1.4: Bun.YAML.stringify writes no space after a key whose value is on the next lines.

exports[`the lock readLock: no lock 1`] = `
{
  "ok": undefined,
}
`;

exports[`the lock readLock: an empty lock 1`] = `
{
  "ok": {},
}
`;

exports[`the lock readLock: a good lock 1`] = `
{
  "ok": {
    "a": {
      "checkedBy": "lint",
      "owner": "N",
      "path": "p",
      "repo": "/x",
      "rules": {
        "r1": "lint",
      },
    },
    "b": {
      "commit": "abc",
      "owner": "M",
      "path": "q",
      "repo": "y",
    },
  },
}
`;

exports[`the lock readLock: no repo 1`] = `
{
  "refused": "aristoteles.lock a: repo is required",
}
`;

exports[`the lock readLock: a blank path 1`] = `
{
  "refused": "aristoteles.lock a: path is required",
}
`;

exports[`the lock readLock: no owner 1`] = `
{
  "refused": "aristoteles.lock a: owner is required",
}
`;

exports[`the lock readLock: an entry that is null 1`] = `
{
  "refused": "aristoteles.lock a: repo is required",
}
`;

exports[`the lock readLock: a lock that does not parse 1`] = `
{
  "refused": "YAML Parse error: Unexpected token",
}
`;

exports[`the lock writeLock: an entry with the three written keys out of order 1`] = `
"a:
  repo: x
  path: p
  owner: "N"
  commit: c
  newest: "n"
  refreshed: 2026-11-10"
`;

exports[`the lock writeLock: two entries and some keys missing 1`] = `
"a:
  repo: x
  path: p
  owner: "N"
  commit: c
b:
  repo: "y"
  path: q
  owner: M
  tag: v1
  rules:
    r1: lint
  checkedBy: lint
  refreshed: d"
`;

exports[`the lock writeLock: a written key that is undefined 1`] = `
"a:
  repo: x
  path: p
  owner: "N"
  newest: "n""
`;

exports[`the lock writeLock: an empty lock 1`] = `"{}"`;

exports[`readFolder a full folder 1`] = `
{
  "ok": {
    "name": "Feature flags",
    "says": 
"
# Feature flags

Says it."
,
